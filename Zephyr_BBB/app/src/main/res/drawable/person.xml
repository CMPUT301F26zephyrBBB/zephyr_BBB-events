    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <!-- outer circle -->
  <path
      android:pathData="M12,2a10,10 0,1 1,0 20a10,10 0,1 1,0 -20z"
      android:strokeWidth="1.7"
      android:fillColor="#00000000"
      android:strokeColor="#245439"/>
  <!-- head -->
  <path
      android:pathData="M12,7a3,3 0,1 1,0 6a3,3 0,1 1,0 -6z"
      android:strokeWidth="1.7"
      android:fillColor="#00000000"
      android:strokeColor="#245439"/>
  <!-- shoulders -->
  <path
      android:pathData="M7,20.662V19a2,2 0,0 1,2 -2h6a2,2 0,0 1,2 2v1.662"
      android:strokeWidth="1.7"
      android:fillColor="#00000000"
      android:strokeColor="#245439"
      android:strokeLineCap="round"/>
</vector>
